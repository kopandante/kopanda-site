---
const year = new Date().getFullYear();

const contacts = [
  {
    label: '+82 40-6826-5472',
    href: 'tel:+824068265472',
    icon: 'M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2z',
  },
  {
    label: 'panda@kopanda.ru',
    href: 'mailto:panda@kopanda.ru',
    icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm8 7L4 6.2V8l8 4.8L20 8V6.2L12 11z',
  },
  {
    label: '@kopanda',
    href: 'https://t.me/kopanda',
    icon: 'M21.9 4.3 18.7 19c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9-8.1c.4-.3-.1-.5-.6-.2L6 12.7l-4.8-1.5c-1-.3-1.1-1 .2-1.5l18.5-7.1c.9-.3 1.6.2 1.3 1.7z',
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Evgeniy Kan — homepage" />
    <link rel="icon" href="/favicon.ico" />
    <title>Evgeniy Kan</title>
  </head>
  <body>
    <main class="card">
      <img class="avatar" src="/me.jpg" alt="Evgeniy Kan" width="128" height="128" />
      <h1>Evgeniy Kan</h1>
      <p class="nick">panda</p>
      <ul class="contacts">
        {contacts.map((c) => (
          <li>
            <a href={c.href}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={c.icon} /></svg>
              <span>{c.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <footer>© 2009 — {year}</footer>
    </main>

    <style>
      :root {
        --bg: #f4f4f5;
        --card: #ffffff;
        --ink: #18181b;
        --muted: #71717a;
        --accent: #2563eb;
        --line: #ececef;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #09090b;
          --card: #131316;
          --ink: #fafafa;
          --muted: #a1a1aa;
          --accent: #60a5fa;
          --line: #26262b;
        }
      }
      * { box-sizing: border-box; margin: 0; }
      html, body {
        height: 100%;
      }
      body {
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 1.5rem;
        background: var(--bg);
        color: var(--ink);
        font: 16px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      .card {
        width: 100%;
        max-width: 22rem;
        padding: 2.5rem 2rem;
        text-align: center;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 1.25rem;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px rgb(0 0 0 / 0.06);
      }
      .avatar {
        width: 128px;
        height: 128px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--card);
        box-shadow: 0 0 0 1px var(--line);
      }
      h1 {
        margin-top: 1.25rem;
        font-size: 1.5rem;
        font-weight: 650;
        letter-spacing: -0.01em;
      }
      .nick {
        margin-top: 0.25rem;
        color: var(--muted);
        font-size: 0.95rem;
      }
      .contacts {
        list-style: none;
        padding: 0;
        margin: 1.75rem 0 0;
        display: grid;
        gap: 0.5rem;
      }
      .contacts a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 0.9rem;
        border-radius: 0.7rem;
        color: var(--ink);
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
      }
      .contacts a:hover {
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        color: var(--accent);
      }
      .contacts svg {
        width: 20px;
        height: 20px;
        flex: none;
        fill: currentColor;
        opacity: 0.85;
      }
      .contacts span {
        font-size: 0.95rem;
      }
      footer {
        margin-top: 1.75rem;
        color: var(--muted);
        font-size: 0.8rem;
      }
    </style>
  </body>
</html>
